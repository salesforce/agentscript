{
  "name": "@agentscript/runtime-vercel",
  "version": "0.1.0",
  "description": "Vercel AI SDK adapter for @agentscript/runtime.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "development": {
        "types": "./src/index.ts",
        "import": "./src/index.ts"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "example": "tsx examples/run-mock.ts",
    "example:live-weather-order": "tsx examples/live-weather-order.ts",
    "example:live-travel-concierge": "tsx examples/live-travel-concierge.ts",
    "example:live-chat-repl": "tsx examples/live-chat-repl.ts",
    "example:live-structured-extraction": "tsx examples/live-structured-extraction.ts"
  },
  "dependencies": {
    "@agentscript/agentforce": "workspace:*",
    "@agentscript/compiler": "workspace:*",
    "@agentscript/memory": "workspace:*",
    "@agentscript/runtime": "workspace:*"
  },
  "peerDependencies": {
    "ai": ">=4.0.0"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^3.0.76",
    "@ai-sdk/openai": "^2.0.106",
    "ai": "^5.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  }
}

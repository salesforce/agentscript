{
  "name": "@agentscript/memory",
  "version": "0.1.0",
  "description": "Embedding + vector-store + semantic-recall + working-memory primitives for AgentScript agents.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "development": {
        "types": "./src/index.ts",
        "import": "./src/index.ts"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "smoke": "pnpm build && node scripts/smoke-memory.mjs",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@agentscript/runtime": "workspace:*",
    "@types/node": "^20.19.37",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0"
  },
  "peerDependencies": {
    "@agentscript/runtime": "workspace:*"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  }
}

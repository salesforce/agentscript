{
  "name": "@agentscript/runtime",
  "version": "0.1.0",
  "description": "Lightweight TypeScript runtime for AgentScript — executes the AgentDSLAuthoring IR emitted by @agentscript/compiler.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "development": {
        "types": "./src/index.ts",
        "import": "./src/index.ts"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "pnpm build && node scripts/smoke-routing.mjs",
    "smoke:hooks": "pnpm build && node scripts/smoke-hooks.mjs",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "example:confirmation": "tsx examples/require-confirmation.ts",
    "example:hooks": "tsx examples/tool-hooks.ts",
    "example:kitchen-sink": "tsx examples/kitchen-sink.ts"
  },
  "dependencies": {
    "@agentscript/compiler": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@agentscript/agentforce": "workspace:*",
    "@hono/node-server": "^1.19.6",
    "hono": "^4.10.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0"
  },
  "keywords": [
    "agentscript",
    "runtime",
    "agent"
  ],
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  }
}

config:
    agent_name: "VoiceV2Languages"

system:
    instructions: "You are a voice assistant."

language:
    default_locale: "en_US"
    additional_locales: "de,en_GB,es,es_MX,fr,fr_CA,it,ja"

modality voice:
    language:
        default_locale: "en_US"
        additional_locales: "de,en_GB,es,es_MX,fr,fr_CA,it,ja"

start_agent main:
    description: "Handle voice interactions"
config:
    agent_name: "VoiceV2All"

system:
    instructions: "You are a voice assistant."

language:
    default_locale: "en_US"
    additional_locales: "fr_CA, it"

modality voice:
    language:
        default_locale: "it"
        additional_locales: "fr_CA, en_US"
    
    session_language_switching: "Multilingual"

    inbound:
        filler_words_detection: True
        keywords:
            - "urgent"
            - "emergency"
            - "help"
        model:
            id: "asr_model_v2"
            parameters:
                prompt: "Try two passes"
                sensitivity: 0.8
                enabled: True

    outbound:
        persona_id: "EQx6HGDYjkDpcli6vorJ"
        model:
            id: "tts_model_v2"
            parameters:
                speed: 0.8
                stability: 1.0
                prompt: "Use an average speed voice with large variances of tonality."
        filler_sentences:
            - waiting: ["One moment please.", "Let me check that."]
            - waiting: ["Please hold on."]
        pronunciations:
            - grapheme: "Eliquis"
              phoneme: "ɛlɪkwɪs"
              type: "IPA"
            - grapheme: "AgentForce"
              phoneme: "EY1 JH AH0 N T F AO1 R S"
              type: "CMU"

    language_settings:
        en_US:
            inbound:
                filler_words_detection: True
                keywords:
                    - "help"
                model:
                    id: "asr_model_en"
                    parameters:
                        prompt: "English"
            outbound:
                persona_id: "EQx6HGDYjkDpcli6vorJ"
                model:
                    id: "tts_model_en"
                    parameters:
                        speed: 1.0
                        stability: 0.9
                filler_sentences:
                    - waiting: ["One moment."]
                pronunciations:
                    - grapheme: "AgentForce"
                      phoneme: "EY1 JH AH0 N T F AO1 R S"
                      type: "CMU"
        fr_CA:
            inbound:
                filler_words_detection: False
                keywords:
                    - "urgent"
                model:
                    id: "asr_model_fr"
                    parameters:
                        prompt: "Bonjour"
            outbound:
                persona_id: "FRx6HGDYjkDpcli6vorJ"
                model:
                    id: "tts_model_fr"
                    parameters:
                        speed: 0.9
                filler_sentences:
                    - waiting: ["Un instant s'il vous plait."]
                pronunciations:
                    - grapheme: "bonjour"
                      phoneme: "bɔ̃ʒuʁ"
                      type: "IPA"

        it:
            outbound:
                persona_id: "SomeItalianPersona"

start_agent main:
    description: "Handle voice interactions"

system:
    instructions: "You are a support assistant."
    messages:
        welcome: "Hello! How can I help?"
        error: "An error occurred."

config:
    developer_name: "Directive_Escalate_Conditional"
    default_agent_user: "test_user"
    description: "Tests escalate directive in conditional after_reasoning"

variables:
    need_help: mutable boolean = False

start_agent main:
    description: "Main topic with conditional escalate"

    reasoning:
        instructions: ->
            | I'm processing your request.

    after_reasoning:
        if @variables.need_help:
            escalate

system:
    instructions: "You are a support assistant."
    messages:
        welcome: "Hello! How can I help?"
        error: "An error occurred."

config:
    developer_name: "Directive_Escalate_Basic"
    default_agent_user: "test_user"
    description: "Tests bare escalate directive in after_reasoning"

start_agent main:
    description: "Main topic with unconditional escalate"

    reasoning:
        instructions: ->
            | I'm processing your request.

    after_reasoning: ->
        escalate

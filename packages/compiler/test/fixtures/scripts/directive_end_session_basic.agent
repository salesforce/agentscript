system:
    instructions: "You are a support assistant."
    messages:
        welcome: "Hello! How can I help?"
        error: "An error occurred."

config:
    developer_name: "Directive_End_Session_Basic"
    default_agent_user: "test_user"
    description: "Tests bare end_session directive in after_reasoning"

start_agent main:
    description: "Main topic with unconditional end_session"

    reasoning:
        instructions: ->
            | I'm processing your request.

    after_reasoning: ->
        end_session

system:
    instructions: "You are a support assistant."
    messages:
        welcome: "Hello! How can I help?"
        error: "An error occurred."

config:
    developer_name: "Directive_End_Session_Before_Reasoning"
    default_agent_user: "test_user"
    description: "Tests end_session directive in before_reasoning"

variables:
    done: mutable boolean = False

start_agent main:
    description: "Main topic with before_reasoning end_session"

    reasoning:
        instructions: ->
            | I'm processing your request.

    before_reasoning:
        if @variables.done:
            end_session

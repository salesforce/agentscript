config:
    agent_name: "VoiceV2Inbound"

system:
    instructions: "You are a voice assistant."

language:
    default_locale: "en_US"
    additional_locales: "fr_CA, it"

modality voice:
    language:
        default_locale: "en_US"
    
    session_language_switching: "Monolingual"

    inbound:
        filler_words_detection: False
        keywords:
            - "urgent"
            - "emergency"
            - "help"
        model:
            id: "asr_model_v2"
            parameters:
                prompt: "Try two passes"
                sensitivity: 0.8

start_agent main:
    description: "Handle voice interactions"
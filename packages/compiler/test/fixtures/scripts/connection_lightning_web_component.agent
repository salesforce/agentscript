system:
    instructions: "You are an AI Agent"
    messages:
        welcome: "Hi, I'm an AI assistant. How can I help you?"
        error: "Sorry, it looks like something has gone wrong."

config:
    developer_name: "LightningWebComponentConnection"
    agent_label: "Lightning Web Component Connection"
    description: "Contains a customer_web_client connection with lightning web components"

access:
    default_agent_user: "NEW AGENT USER"

start_agent start_agent:
    description: "start agent block"

connection customer_web_client:
    description: "Web client connection"

    response_formats:
        acme_menu_card:
            label: "Menu Card"
            description: "Use this format to show the menu."
            inputs:
                menu_card:
                    schema: "lightning_web_component://acme__MenuCard"
                    type: object
                        fields:
                            title: string
                                description: "the menu title"
                            subtitle: string
                                description: "an optional subtitle"
                                is_required: False
                            itemCount: number = 0
                                description: "number of menu items"
                            tags: list[string] = ["vegan", "spicy"]
                                description: "menu tags"
                            settings: object
                                description: "display settings; the component defines their shape"

        c_order_summary:
            label: "Order Summary"
            description: "Use this format to summarize the order."
            inputs:
                order_summary:
                    schema: "lightning_web_component://c__orderSummary"
                    type: object
                        fields:
                            orderNumber: string
                                description: "the order number"

# Empty inline-list additional_locales (`[]`) — must compile to an empty list
# without emitting the "Unable to extract ... from inline list syntax" warning.
system:
    instructions: "You are a single-language agent."
    messages:
        welcome: "Welcome!"
        error: "An error occurred."

config:
    agent_type: "AgentforceServiceAgent"
    developer_name: "Empty_List_Locale_Agent"
    default_agent_user: "admin@example.com"
    description: "Agent with an empty inline-list additional_locales value"

language:
    default_locale: "en_US"
    additional_locales: []
    all_additional_locales: False
start_agent main:
    description: "Empty-list-locale entry point"
    reasoning:
        instructions: ->
            | Process the user request in English.

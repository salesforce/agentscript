system:
    instructions: "You are a support assistant."
    messages:
        welcome: "Hello! How can I help?"
        error: "An error occurred."

config:
    developer_name: "Directive_End_Session_Conditional"
    default_agent_user: "test_user"
    description: "Tests end_session directive in conditional after_reasoning"

variables:
    finished: mutable boolean = False

start_agent main:
    description: "Main topic with conditional end_session"

    reasoning:
        instructions: ->
            | I'm processing your request.

    after_reasoning:
        if @variables.finished:
            end_session

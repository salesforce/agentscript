system:
    instructions: "You are a support assistant."
    messages:
        welcome: "Hello! How can I help?"
        error: "An error occurred."

config:
    developer_name: "Directive_Escalate_Before_Reasoning"
    default_agent_user: "test_user"
    description: "Tests escalate directive in before_reasoning"

variables:
    blocked: mutable boolean = False

start_agent main:
    description: "Main topic with before_reasoning escalate"

    reasoning:
        instructions: ->
            | I'm processing your request.

    before_reasoning:
        if @variables.blocked:
            escalate

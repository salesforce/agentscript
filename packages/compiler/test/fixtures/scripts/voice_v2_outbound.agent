config:
    agent_name: "VoiceV2OutboundOnly"

system:
    instructions: "You are a voice assistant."

language:
    default_locale: "en_US"
    additional_locales: "fr_CA, it, de"

modality voice:
    language:
        default_locale: "en_US"

    outbound:
        persona_id: "EQx6HGDYjkDpcli6vorJ"
        model:
            id: "tts_model"
            parameters:
                speed: 0.8
                stability: 1.0
                prompt: "Use an average speed voice with large variances of tonality."
        filler_sentences:
            - waiting: ["One moment please.", "Let me check that."]
            - waiting: ["Please hold on."]
        pronunciations:
            - grapheme: "Eliquis"
              phoneme: "ɛlɪkwɪs"
              type: "IPA"
            - grapheme: "AgentForce"
              phoneme: "EY1 JH AH0 N T F AO1 R S"
              type: "CMU"

start_agent main:
    description: "Handle voice interactions"
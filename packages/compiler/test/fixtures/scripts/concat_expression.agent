config:
    developer_name: "Concat_Expression"
    description: "Tests the concat() built-in with positional, list, and sep arguments"

variables:
    first_name: mutable string = ""
    fragments: mutable list[string] = []
    greeting: mutable string = ""
    joined: mutable string = ""

start_agent main:
    description: "Builds strings with concat()"

    before_reasoning:
        set @variables.greeting = concat("Hi ", @variables.first_name)
        set @variables.joined = concat(@variables.fragments, sep=", ")

    reasoning:
        instructions: ->
            | Greet the customer.
              Greeting: {! @variables.greeting }

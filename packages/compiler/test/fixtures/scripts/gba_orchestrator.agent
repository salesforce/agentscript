system:
    instructions: |
        ## Goal-Based Sales Agent
        Domain: Sales. Help users with lead generation and account management.
    messages:
        welcome: "Hello! How can I help with your sales goals?"
        error: "Sorry, something went wrong."

config:
    developer_name: "SalesGoalBasedAgent"
    agent_type: "GoalBasedAgent"
    description: "A goal-based sales agent"

orchestrator agent:
    actions:
        lookup_account:
            description: "Look up a Salesforce account by name"
            target: "flow://LookupAccount"
            inputs:
                account_name: string
            outputs:
                account_id: string
                revenue: number
    reasoning:
        instructions: ->
            | You are a goal-based sales agent. Your goal is to help users
            | with lead generation and account management.
            | Use the available tools to answer questions and take actions.
        actions:
            lookup_account:
                description: "Look up a Salesforce account"

config:
    agent_name: "AdaptiveSupport"
    agent_type: "AgentforceServiceAgent"
    default_agent_user: "test@example.com"

system:
    instructions: ->
        | You are a customer support assistant.

        if @system_variables.current_modality == "voice":
            | Keep responses concise, conversational, and free of formatting.
        else if @system_variables.current_connection == "slack":
            | Use short paragraphs and Slack-compatible formatting.
        else:
            | Use the standard text response style.

start_agent main:
    label: "Adaptive Support"
    description: "Adapts instructions to the current interaction."
    reasoning:
        instructions: ->
            | Resolve the customer's request.

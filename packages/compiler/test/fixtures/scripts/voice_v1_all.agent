config:
    agent_name: "VoiceV1All"

system:
    instructions: "You are a voice assistant."

modality voice:
    inbound_filler_words_detection: True
    inbound_keywords:
        keywords:
            - "urgent"
            - "emergency"
            - "help"
    voice_id: "EQx6HGDYjkDpcli6vorJ"
    outbound_speed: 1.2
    outbound_style_exaggeration: 0.7
    outbound_stability: 0.75
    outbound_similarity: 0.8
    pronunciation_dict:
        - grapheme: "Eliquis"
          phoneme: "ɛlɪkwɪs"
          type: "IPA"
        - grapheme: "AgentForce"
          phoneme: "EY1 JH AH0 N T F AO1 R S"
          type: "CMU"
    outbound_filler_sentences:
        - waiting: ["One moment please.", "Let me look that up."]
        - waiting: ["Please hold on."]
    additional_configs:
        speak_up_config:
            speak_up_first_wait_time_ms: 15000
            speak_up_follow_up_wait_time_ms: 20000
            speak_up_message: "Are you still there?"
        endpointing_config:
            max_wait_time_ms: 2000
        beepboop_config:
            max_wait_time_ms: 1500

start_agent main:
    description: "Handle voice interactions"

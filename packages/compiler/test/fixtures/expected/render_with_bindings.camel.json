{
  "schemaVersion": "2.0",
  "globalConfiguration": {
    "developerName": "RenderWithBindings",
    "label": "Render With Bindings Agent",
    "description": "Bind action outputs and variables to response format inputs with render `with`",
    "enableEnhancedEventLogs": false,
    "agentType": "EinsteinServiceAgent",
    "contextVariables": [
      {
        "developerName": "session_id",
        "label": "Session Id",
        "description": "Messaging session id",
        "dataType": "string",
        "fieldMapping": "MessagingSession.Id"
      }
    ],
    "defaultAgentUser": "support_bot@example.com"
  },
  "agentVersion": {
    "plannerType": "Atlas__ConcurrentMultiAgentOrchestration",
    "systemMessages": [
      {
        "message": "Hi! How can I help with your order?",
        "messageType": "Welcome"
      },
      {
        "message": "Sorry, something went wrong.",
        "messageType": "Error"
      }
    ],
    "stateVariables": [
      {
        "developerName": "AgentScriptInternal_next_topic",
        "label": "Next Topic",
        "description": "The next topic to be visited",
        "dataType": "string",
        "isList": false,
        "default": "\"__EMPTY__\"",
        "visibility": "Internal"
      },
      {
        "developerName": "AgentScriptInternal_agent_instructions",
        "label": "Agent Instructions",
        "description": "The agent instructions",
        "dataType": "string",
        "isList": false,
        "default": "''",
        "visibility": "Internal"
      },
      {
        "developerName": "customer_name",
        "label": "Customer Name",
        "description": "Customer Name",
        "dataType": "string",
        "isList": false,
        "visibility": "Internal",
        "default": "'Ada'"
      }
    ],
    "initialNode": "main",
    "nodes": [
      {
        "type": "subagent",
        "reasoningType": "salesforce.default",
        "description": "Route support requests",
        "tools": [],
        "developerName": "main",
        "label": "Main",
        "actionDefinitions": [],
        "instructions": "You are an order support agent. Answer through the channel's rich formats."
      },
      {
        "type": "subagent",
        "reasoningType": "salesforce.default",
        "description": "Answer questions about an order",
        "tools": [
          {
            "type": "action",
            "target": "Get_Order",
            "boundInputs": {},
            "llmInputs": [
              "order_number"
            ],
            "stateUpdates": [],
            "name": "Get_Order",
            "renderRules": [
              {
                "surfaceType": "messaging",
                "responseFormatName": "order_card",
                "endTurn": true,
                "inputBindings": {
                  "title": "\"Order \" + result.order_number",
                  "order_total": "result.total",
                  "is_delayed": "result.days_late > 0",
                  "status_label": "\"Delayed\" if result.days_late > 0 else \"On time\"",
                  "currency_code": "\"USD\"",
                  "note": null,
                  "customer": {
                    "name": "state.customer_name",
                    "tier": "\"standard\"",
                    "session_id": "variables.session_id"
                  },
                  "items": [
                    {
                      "name": "result.first_item",
                      "quantity": "result.first_item_quantity"
                    },
                    {
                      "name": "\"Gift wrap\"",
                      "quantity": "1"
                    }
                  ],
                  "tracking_numbers": "result.tracking_numbers"
                }
              },
              {
                "surfaceType": "service_email",
                "responseFormatName": "order_email",
                "endTurn": false,
                "inputBindings": {
                  "subject": "\"Your order \" + result.order_number",
                  "greeting": "\"Hi \" + state.customer_name",
                  "customer_question": "system.input_text",
                  "signed_by": "connection.service_email.signature",
                  "footer": {
                    "text": "\"Sent by \" + connection.service_email.signature"
                  }
                }
              }
            ]
          }
        ],
        "developerName": "orders",
        "label": "Orders",
        "actionDefinitions": [
          {
            "developerName": "Get_Order",
            "label": "Get Order",
            "description": "Look up an order",
            "includeInProgressIndicator": false,
            "invocationTargetType": "flow",
            "invocationTargetName": "GetOrder",
            "inputType": [
              {
                "developerName": "order_number",
                "label": "Order Number",
                "description": "Order Number",
                "dataType": "String",
                "isList": false,
                "required": false,
                "isUserInput": false
              }
            ],
            "outputType": [
              {
                "developerName": "order_number",
                "label": "Order Number",
                "description": "Order Number",
                "dataType": "String",
                "isList": false,
                "isUsedByPlanner": true,
                "isDisplayable": false
              },
              {
                "developerName": "total",
                "label": "Total",
                "description": "Total",
                "dataType": "Double",
                "isList": false,
                "isUsedByPlanner": true,
                "isDisplayable": false
              },
              {
                "developerName": "days_late",
                "label": "Days Late",
                "description": "Days Late",
                "dataType": "Integer",
                "isList": false,
                "isUsedByPlanner": true,
                "isDisplayable": false
              },
              {
                "developerName": "first_item",
                "label": "First Item",
                "description": "First Item",
                "dataType": "String",
                "isList": false,
                "isUsedByPlanner": true,
                "isDisplayable": false
              },
              {
                "developerName": "first_item_quantity",
                "label": "First Item Quantity",
                "description": "First Item Quantity",
                "dataType": "Integer",
                "isList": false,
                "isUsedByPlanner": true,
                "isDisplayable": false
              },
              {
                "developerName": "tracking_numbers",
                "label": "Tracking Numbers",
                "description": "Tracking Numbers",
                "dataType": "String",
                "isList": true,
                "isUsedByPlanner": true,
                "isDisplayable": false
              }
            ]
          }
        ],
        "instructions": "You are an order support agent. Answer through the channel's rich formats.",
        "focusPrompt": "{{state.AgentScriptInternal_agent_instructions}}",
        "beforeReasoningIteration": [
          {
            "type": "action",
            "target": "__state_update_action__",
            "enabled": "True",
            "stateUpdates": [
              {
                "AgentScriptInternal_agent_instructions": "template::\nLook up the order, then show its summary."
              }
            ]
          }
        ]
      }
    ],
    "surfaces": [
      {
        "surfaceType": "messaging",
        "outboundRouteConfigs": [],
        "responseFormats": [
          {
            "developerName": "order_card",
            "label": "Order Card",
            "description": "Order summary card",
            "inputSchema": "{\"type\":\"object\",\"properties\":{\"title\":{\"type\":\"string\"},\"order_total\":{\"type\":\"number\"},\"is_delayed\":{\"type\":\"boolean\"},\"status_label\":{\"type\":\"string\"},\"currency_code\":{\"type\":\"string\",\"const\":\"USD\"},\"note\":{\"type\":\"string\"},\"customer\":{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"},\"tier\":{\"type\":\"string\",\"const\":\"standard\"},\"session_id\":{\"type\":\"string\"}},\"required\":[\"name\",\"tier\",\"session_id\"]},\"items\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"},\"quantity\":{\"type\":\"integer\",\"const\":1}},\"required\":[\"name\",\"quantity\"]}},\"tracking_numbers\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}}},\"required\":[\"title\",\"order_total\",\"is_delayed\",\"status_label\",\"currency_code\",\"customer\",\"items\",\"tracking_numbers\"]}"
          }
        ]
      },
      {
        "surfaceType": "service_email",
        "outboundRouteConfigs": [],
        "responseFormats": [
          {
            "developerName": "order_email",
            "label": "Order Email",
            "description": "Order update email",
            "inputSchema": "{\"type\":\"object\",\"properties\":{\"subject\":{\"type\":\"string\"},\"greeting\":{\"type\":\"string\"},\"customer_question\":{\"type\":\"string\"},\"signed_by\":{\"type\":\"string\",\"const\":\"{{connection.service_email.signature}}\"},\"footer\":{\"type\":\"object\",\"properties\":{\"text\":{\"type\":\"string\"}},\"required\":[\"text\"]}},\"required\":[\"subject\",\"greeting\",\"customer_question\",\"signed_by\",\"footer\"]}"
          }
        ],
        "inputParameters": [
          {
            "developerName": "signature",
            "label": "Signature",
            "description": "Signature",
            "dataType": "string",
            "defaultValue": "'The Support Team'"
          }
        ]
      }
    ],
    "modalityParameters": {},
    "additionalParameters": {
      "reset_to_initial_node": true,
      "system_messages": "[{\"message\": \"Hi! How can I help with your order?\", \"messageType\": \"Welcome\"}, {\"message\": \"Sorry, something went wrong.\", \"messageType\": \"Error\"}]"
    }
  }
}

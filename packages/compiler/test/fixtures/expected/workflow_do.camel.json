{
  "schemaVersion": "2.0",
  "globalConfiguration": {
    "developerName": "returns_agent",
    "label": "Returns Agent",
    "description": "Processes order returns through a workflow with natural-language steps.",
    "enableEnhancedEventLogs": false,
    "agentType": "EinsteinServiceAgent",
    "contextVariables": [],
    "defaultAgentUser": "returns_agent@example.com"
  },
  "agentVersion": {
    "plannerType": "Atlas__ConcurrentMultiAgentOrchestration",
    "systemMessages": [
      {
        "message": "Hello! How can I help with your order?",
        "messageType": "Welcome"
      },
      {
        "message": "Sorry, something went wrong.",
        "messageType": "Error"
      }
    ],
    "stateVariables": [
      {
        "developerName": "AgentScriptInternal_next_topic",
        "label": "Next Topic",
        "description": "The next topic to be visited",
        "dataType": "string",
        "isList": false,
        "default": "\"__EMPTY__\"",
        "visibility": "Internal"
      },
      {
        "developerName": "AgentScriptInternal_agent_instructions",
        "label": "Agent Instructions",
        "description": "The agent instructions",
        "dataType": "string",
        "isList": false,
        "default": "''",
        "visibility": "Internal"
      },
      {
        "developerName": "order_id",
        "label": "Order Id",
        "description": "The order to return",
        "dataType": "string",
        "isList": false,
        "visibility": "Internal",
        "default": "''"
      },
      {
        "developerName": "is_vip",
        "label": "Is Vip",
        "description": "Whether the customer is a VIP",
        "dataType": "boolean",
        "isList": false,
        "visibility": "Internal",
        "default": false
      },
      {
        "developerName": "AgentScriptInternal_workflow_condition_1",
        "label": "Workflow Condition 1",
        "description": "Condition of a workflow if at nesting depth 1, stored before its branches run",
        "dataType": "boolean",
        "isList": false,
        "visibility": "Internal"
      },
      {
        "developerName": "AgentScriptInternal_system_instructions",
        "label": "System Instructions",
        "description": "Dynamic system instructions for the current turn",
        "dataType": "string",
        "isList": false,
        "default": "''",
        "visibility": "Internal"
      }
    ],
    "initialNode": "intent_router",
    "nodes": [
      {
        "type": "subagent",
        "reasoningType": "salesforce.default",
        "description": "Route the user to the right place",
        "tools": [
          {
            "type": "action",
            "target": "__state_update_action__",
            "stateUpdates": [
              {
                "AgentScriptInternal_next_topic": "\"return_workflow\""
              }
            ],
            "name": "start_return",
            "description": "Collects order details, processes a return, and confirms."
          }
        ],
        "developerName": "intent_router",
        "label": "Intent Router",
        "actionDefinitions": [],
        "instructions": "You are a helpful returns assistant.",
        "focusPrompt": "{{state.AgentScriptInternal_agent_instructions}}",
        "beforeReasoningIteration": [
          {
            "type": "action",
            "target": "__state_update_action__",
            "enabled": "True",
            "stateUpdates": [
              {
                "AgentScriptInternal_agent_instructions": "template::\nUse start_return when the user wants to return an order."
              }
            ]
          }
        ],
        "afterAllToolCalls": [
          {
            "type": "handoff",
            "target": "return_workflow",
            "enabled": "state.AgentScriptInternal_next_topic==\"return_workflow\"",
            "stateUpdates": [
              {
                "AgentScriptInternal_next_topic": "\"__EMPTY__\""
              }
            ]
          }
        ]
      },
      {
        "type": "subagent",
        "reasoningType": "salesforce.default",
        "description": "Answer questions about orders",
        "tools": [],
        "developerName": "order_inquiries",
        "label": "Order Inquiries",
        "actionDefinitions": [],
        "instructions": "You are a helpful returns assistant.",
        "focusPrompt": "{{state.AgentScriptInternal_agent_instructions}}",
        "beforeReasoningIteration": [
          {
            "type": "action",
            "target": "__state_update_action__",
            "enabled": "True",
            "stateUpdates": [
              {
                "AgentScriptInternal_agent_instructions": "template::\nAnswer questions about order {{state.order_id}}."
              }
            ]
          }
        ]
      },
      {
        "type": "workflow",
        "developerName": "return_workflow",
        "label": "Return Workflow",
        "steps": [
          {
            "name": "collect",
            "directives": [
              {
                "type": "do",
                "instructions": "{{state.AgentScriptInternal_system_instructions}}\n\nAsk the user for the order to return, then call lookup_order\nto check that the order exists.",
                "tools": [
                  {
                    "type": "action",
                    "target": "lookup_order",
                    "name": "lookup_order",
                    "llmInputs": [
                      "orderId"
                    ]
                  }
                ],
                "developerName": "return_workflow_collect_do_01"
              },
              {
                "type": "do",
                "instructions": "{{state.AgentScriptInternal_system_instructions}}\n\nTell the user the status of the order.",
                "developerName": "return_workflow_collect_do_02"
              }
            ]
          },
          {
            "name": "confirm_and_close",
            "directives": [
              {
                "type": "action",
                "target": "__state_update_action__",
                "boundInputs": {
                  "condition": "state.is_vip"
                },
                "stateUpdates": [
                  {
                    "AgentScriptInternal_workflow_condition_1": "result.condition"
                  }
                ],
                "chatHistoryBehavior": {
                  "addToChatHistory": false
                },
                "developerName": "return_workflow_confirm_and_close_action_01"
              },
              {
                "type": "do",
                "instructions": "{{state.AgentScriptInternal_system_instructions}}\n\nThank the customer for being a VIP.",
                "enabled": "state.AgentScriptInternal_workflow_condition_1",
                "developerName": "return_workflow_confirm_and_close_do_02"
              },
              {
                "type": "do",
                "instructions": "{{state.AgentScriptInternal_system_instructions}}\n\nCall process_return for order {{state.order_id}}\nand say the return id back to the user.",
                "tools": [
                  {
                    "type": "action",
                    "target": "process_return",
                    "name": "process_return",
                    "llmInputs": [
                      "orderId"
                    ]
                  }
                ],
                "developerName": "return_workflow_confirm_and_close_do_03"
              },
              {
                "type": "say",
                "text": "System Prompt:\n\n{{state.AgentScriptInternal_system_instructions}}\n\nMessage for the system to follow:\n\nYour return has started.",
                "developerName": "return_workflow_confirm_and_close_say_04"
              },
              {
                "type": "handoff",
                "target": "order_inquiries",
                "developerName": "return_workflow_confirm_and_close_handoff_05"
              }
            ]
          }
        ],
        "onInit": [
          {
            "type": "action",
            "target": "__state_update_action__",
            "stateUpdates": [
              {
                "AgentScriptInternal_system_instructions": "template::You are a helpful returns assistant."
              }
            ]
          }
        ],
        "description": "Collects order details, processes a return, and confirms.",
        "actionDefinitions": [
          {
            "developerName": "lookup_order",
            "label": "Lookup Order",
            "description": "Look up an order by its id.",
            "includeInProgressIndicator": false,
            "invocationTargetType": "flow",
            "invocationTargetName": "lookup_order",
            "inputType": [
              {
                "developerName": "orderId",
                "label": "Order Id",
                "description": "Order Id",
                "dataType": "String",
                "isList": false,
                "required": true,
                "isUserInput": false
              }
            ],
            "outputType": [
              {
                "developerName": "status",
                "label": "Status",
                "description": "Status",
                "dataType": "String",
                "isList": false,
                "isUsedByPlanner": true,
                "isDisplayable": false
              }
            ]
          },
          {
            "developerName": "process_return",
            "label": "Process Return",
            "description": "Start a return for an order.",
            "includeInProgressIndicator": false,
            "invocationTargetType": "flow",
            "invocationTargetName": "process_return",
            "inputType": [
              {
                "developerName": "orderId",
                "label": "Order Id",
                "description": "Order Id",
                "dataType": "String",
                "isList": false,
                "required": true,
                "isUserInput": false
              },
              {
                "developerName": "reason",
                "label": "Reason",
                "description": "Reason",
                "dataType": "String",
                "isList": false,
                "required": false,
                "isUserInput": false
              }
            ],
            "outputType": [
              {
                "developerName": "returnId",
                "label": "Return Id",
                "description": "Return Id",
                "dataType": "String",
                "isList": false,
                "isUsedByPlanner": true,
                "isDisplayable": false
              }
            ],
            "requireUserConfirmation": true
          }
        ]
      }
    ],
    "surfaces": [],
    "modalityParameters": {},
    "additionalParameters": {
      "reset_to_initial_node": true,
      "system_messages": "[{\"message\": \"Hello! How can I help with your order?\", \"messageType\": \"Welcome\"}, {\"message\": \"Sorry, something went wrong.\", \"messageType\": \"Error\"}]"
    }
  }
}

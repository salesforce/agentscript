{
  "schema_version": "2.0",
  "global_configuration": {
    "developer_name": "refund_agent",
    "label": "Refund Agent",
    "description": "Processes order refunds through a deterministic workflow.",
    "enable_enhanced_event_logs": false,
    "agent_type": "EinsteinServiceAgent",
    "context_variables": [],
    "default_agent_user": "refund_agent@example.com"
  },
  "agent_version": {
    "planner_type": "Atlas__ConcurrentMultiAgentOrchestration",
    "system_messages": [
      {
        "message": "Hello! How can I help with your order?",
        "message_type": "Welcome"
      },
      {
        "message": "Sorry, something went wrong.",
        "message_type": "Error"
      }
    ],
    "state_variables": [
      {
        "developer_name": "AgentScriptInternal_next_topic",
        "label": "Next Topic",
        "description": "The next topic to be visited",
        "data_type": "string",
        "is_list": false,
        "default": "\"__EMPTY__\"",
        "visibility": "Internal"
      },
      {
        "developer_name": "AgentScriptInternal_agent_instructions",
        "label": "Agent Instructions",
        "description": "The agent instructions",
        "data_type": "string",
        "is_list": false,
        "default": "''",
        "visibility": "Internal"
      },
      {
        "developer_name": "order_id",
        "label": "Order Id",
        "description": "The order to refund",
        "data_type": "string",
        "is_list": false,
        "visibility": "Internal",
        "default": "''"
      },
      {
        "developer_name": "refund_complete",
        "label": "Refund Complete",
        "description": "Whether the refund was issued",
        "data_type": "boolean",
        "is_list": false,
        "visibility": "Internal",
        "default": false
      },
      {
        "developer_name": "customer_name",
        "label": "Customer Name",
        "description": "The customer's name",
        "data_type": "string",
        "is_list": false,
        "visibility": "Internal",
        "default": "''"
      }
    ],
    "initial_node": "intent_router",
    "nodes": [
      {
        "type": "subagent",
        "reasoning_type": "salesforce.default",
        "description": "Route the user to the right place",
        "tools": [
          {
            "type": "action",
            "target": "__state_update_action__",
            "state_updates": [
              {
                "AgentScriptInternal_next_topic": "\"refund_workflow\""
              }
            ],
            "name": "start_refund",
            "description": "Collects an order id, issues a refund, and confirms."
          }
        ],
        "developer_name": "intent_router",
        "label": "Intent Router",
        "action_definitions": [],
        "instructions": "You are a helpful refund assistant.",
        "focus_prompt": "{{state.AgentScriptInternal_agent_instructions}}",
        "before_reasoning_iteration": [
          {
            "type": "action",
            "target": "__state_update_action__",
            "enabled": "True",
            "state_updates": [
              {
                "AgentScriptInternal_agent_instructions": "template::\nUse start_refund when the user wants a refund."
              }
            ]
          }
        ],
        "after_all_tool_calls": [
          {
            "type": "handoff",
            "target": "refund_workflow",
            "enabled": "state.AgentScriptInternal_next_topic==\"refund_workflow\"",
            "state_updates": [
              {
                "AgentScriptInternal_next_topic": "\"__EMPTY__\""
              }
            ]
          }
        ]
      },
      {
        "type": "subagent",
        "reasoning_type": "salesforce.default",
        "description": "Answer follow-up questions after a refund",
        "tools": [],
        "developer_name": "refund_followup",
        "label": "Refund Followup",
        "action_definitions": [],
        "instructions": "You are a helpful refund assistant.",
        "focus_prompt": "{{state.AgentScriptInternal_agent_instructions}}",
        "before_reasoning_iteration": [
          {
            "type": "action",
            "target": "__state_update_action__",
            "enabled": "True",
            "state_updates": [
              {
                "AgentScriptInternal_agent_instructions": "template::\nAnswer any follow-up questions about the refund for order {{state.order_id}}."
              }
            ]
          }
        ]
      },
      {
        "type": "workflow",
        "developer_name": "refund_workflow",
        "label": "Refund Workflow",
        "steps": [
          {
            "name": "greet",
            "directives": [
              {
                "type": "say",
                "text": "Hi! I can help you process a refund.",
                "developer_name": "refund_workflow_greet_say_01"
              }
            ]
          },
          {
            "name": "collect_order",
            "directives": [
              {
                "type": "ask_for",
                "llm_inputs": [
                  "order_id"
                ],
                "instructions": "Ask the user for the order id they want refunded.",
                "developer_name": "refund_workflow_collect_order_ask_for_01"
              }
            ]
          },
          {
            "name": "issue_refund",
            "directives": [
              {
                "type": "action",
                "target": "__state_update_action__",
                "state_updates": [
                  {
                    "customer_name": "\"SomeData\""
                  }
                ],
                "developer_name": "refund_workflow_issue_refund_action_01"
              },
              {
                "type": "action",
                "target": "issue_refund",
                "bound_inputs": {
                  "orderId": "state.order_id"
                },
                "state_updates": [
                  {
                    "refund_complete": "True"
                  }
                ],
                "developer_name": "refund_workflow_issue_refund_action_02"
              },
              {
                "type": "say",
                "text": "Your refund for order {{state.order_id}} has been issued.",
                "enabled": "state.refund_complete == True",
                "developer_name": "refund_workflow_issue_refund_say_03"
              },
              {
                "type": "handoff",
                "target": "refund_followup",
                "enabled": "state.refund_complete == True",
                "developer_name": "refund_workflow_issue_refund_handoff_04"
              },
              {
                "type": "handoff",
                "target": "__human__",
                "enabled": "not (state.refund_complete == True)",
                "developer_name": "refund_workflow_issue_refund_handoff_05"
              }
            ]
          }
        ],
        "description": "Collects an order id, issues a refund, and confirms.",
        "action_definitions": [
          {
            "developer_name": "issue_refund",
            "label": "Issue Refund",
            "description": "Issue a refund for the given order id.",
            "include_in_progress_indicator": true,
            "invocation_target_type": "standardInvocableAction",
            "invocation_target_name": "issueRefund",
            "input_type": [
              {
                "developer_name": "orderId",
                "label": "Order Id",
                "description": "Order Id",
                "data_type": "String",
                "is_list": false,
                "required": true,
                "is_user_input": false
              }
            ],
            "output_type": [
              {
                "developer_name": "status",
                "label": "Status",
                "description": "Status",
                "data_type": "String",
                "is_list": false,
                "is_used_by_planner": true,
                "is_displayable": false
              }
            ],
            "require_user_confirmation": false,
            "progress_indicator_message": "Issuing your refund..."
          }
        ]
      }
    ],
    "surfaces": [],
    "modality_parameters": {},
    "additional_parameters": {
      "reset_to_initial_node": true,
      "system_messages": "[{\"message\": \"Hello! How can I help with your order?\", \"messageType\": \"Welcome\"}, {\"message\": \"Sorry, something went wrong.\", \"messageType\": \"Error\"}]"
    }
  }
}

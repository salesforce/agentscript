{
  "schema_version": "2.0",
  "global_configuration": {
    "developer_name": "FileUploadManaged",
    "label": "File Upload Managed",
    "description": "File Upload Managed",
    "enable_enhanced_event_logs": false,
    "agent_type": "EinsteinServiceAgent",
    "context_variables": [],
    "default_agent_user": "service_user"
  },
  "agent_version": {
    "planner_type": "Atlas__ConcurrentMultiAgentOrchestration",
    "system_messages": [],
    "state_variables": [
      {
        "developer_name": "AgentScriptInternal_next_topic",
        "label": "Next Topic",
        "description": "The next topic to be visited",
        "data_type": "string",
        "is_list": false,
        "default": "\"__EMPTY__\"",
        "visibility": "Internal"
      },
      {
        "developer_name": "AgentScriptInternal_agent_instructions",
        "label": "Agent Instructions",
        "description": "The agent instructions",
        "data_type": "string",
        "is_list": false,
        "default": "''",
        "visibility": "Internal"
      },
      {
        "developer_name": "needs_summary",
        "label": "Needs Summary",
        "description": "Needs Summary",
        "data_type": "boolean",
        "is_list": false,
        "visibility": "Internal",
        "default": false
      },
      {
        "developer_name": "doc_id",
        "label": "Doc Id",
        "description": "Doc Id",
        "data_type": "string",
        "is_list": false,
        "visibility": "Internal",
        "default": "''"
      },
      {
        "developer_name": "AgentScriptInternal_condition_1",
        "label": "Runtime Condition 1",
        "description": "Runtime condition evaluation for if statements",
        "data_type": "boolean",
        "is_list": false,
        "visibility": "Internal"
      }
    ],
    "initial_node": "intake",
    "nodes": [
      {
        "type": "subagent",
        "reasoning_type": "salesforce.default",
        "description": "Reviews uploaded files and answers questions about them",
        "tools": [
          {
            "type": "action",
            "target": "summarize_doc",
            "bound_inputs": {
              "doc_id": "system.uploaded_files[0].id"
            },
            "llm_inputs": [],
            "state_updates": [],
            "name": "summarize_doc"
          }
        ],
        "developer_name": "intake",
        "label": "Intake",
        "action_definitions": [
          {
            "developer_name": "summarize_doc",
            "label": "Summarize Doc",
            "description": "Summarize an uploaded document",
            "include_in_progress_indicator": false,
            "invocation_target_type": "flow",
            "invocation_target_name": "summarize_doc",
            "input_type": [
              {
                "developer_name": "doc_id",
                "label": "Doc Id",
                "description": "Doc Id",
                "data_type": "String",
                "is_list": false,
                "required": false,
                "is_user_input": false
              }
            ],
            "output_type": [
              {
                "developer_name": "summary",
                "label": "Summary",
                "description": "Summary",
                "data_type": "String",
                "is_list": false,
                "is_used_by_planner": true,
                "is_displayable": false
              }
            ]
          }
        ],
        "instructions": "You are a document-processing assistant.",
        "focus_prompt": "{{state.AgentScriptInternal_agent_instructions}}",
        "before_reasoning_iteration": [
          {
            "type": "action",
            "target": "__state_update_action__",
            "enabled": "True",
            "state_updates": [
              {
                "AgentScriptInternal_agent_instructions": "template::\nYou have {{len(system.uploaded_files)}} file(s) uploaded.\nThe most recent upload is {{system.uploaded_files[-1].name}}."
              }
            ]
          },
          {
            "type": "action",
            "target": "__state_update_action__",
            "enabled": "True",
            "state_updates": [
              {
                "AgentScriptInternal_condition_1": "state.needs_summary"
              }
            ]
          },
          {
            "type": "action",
            "target": "__state_update_action__",
            "enabled": "state.AgentScriptInternal_condition_1",
            "state_updates": [
              {
                "AgentScriptInternal_agent_instructions": "template::{{state.AgentScriptInternal_agent_instructions}}\nFocus on the first three documents: {{system.uploaded_files[0:3]}}"
              }
            ]
          }
        ],
        "file_references": [
          {
            "all": true
          },
          {
            "index": -1
          },
          {
            "slice": {
              "start": 0,
              "stop": 3,
              "step": null
            },
            "enabled": "state.AgentScriptInternal_condition_1"
          }
        ]
      }
    ],
    "surfaces": [],
    "modality_parameters": {},
    "additional_parameters": {
      "reset_to_initial_node": true
    },
    "file_upload": {
      "mode": "managed"
    }
  }
}

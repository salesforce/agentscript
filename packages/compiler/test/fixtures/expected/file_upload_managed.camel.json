{
  "schemaVersion": "2.0",
  "globalConfiguration": {
    "developerName": "FileUploadManaged",
    "label": "File Upload Managed",
    "description": "File Upload Managed",
    "enableEnhancedEventLogs": false,
    "agentType": "EinsteinServiceAgent",
    "contextVariables": [],
    "defaultAgentUser": "service_user"
  },
  "agentVersion": {
    "plannerType": "Atlas__ConcurrentMultiAgentOrchestration",
    "systemMessages": [],
    "stateVariables": [
      {
        "developerName": "AgentScriptInternal_next_topic",
        "label": "Next Topic",
        "description": "The next topic to be visited",
        "dataType": "string",
        "isList": false,
        "default": "\"__EMPTY__\"",
        "visibility": "Internal"
      },
      {
        "developerName": "AgentScriptInternal_agent_instructions",
        "label": "Agent Instructions",
        "description": "The agent instructions",
        "dataType": "string",
        "isList": false,
        "default": "''",
        "visibility": "Internal"
      },
      {
        "developerName": "needs_summary",
        "label": "Needs Summary",
        "description": "Needs Summary",
        "dataType": "boolean",
        "isList": false,
        "visibility": "Internal",
        "default": false
      },
      {
        "developerName": "doc_id",
        "label": "Doc Id",
        "description": "Doc Id",
        "dataType": "string",
        "isList": false,
        "visibility": "Internal",
        "default": "''"
      },
      {
        "developerName": "AgentScriptInternal_condition_1",
        "label": "Runtime Condition 1",
        "description": "Runtime condition evaluation for if statements",
        "dataType": "boolean",
        "isList": false,
        "visibility": "Internal"
      }
    ],
    "initialNode": "intake",
    "nodes": [
      {
        "type": "subagent",
        "reasoningType": "salesforce.default",
        "description": "Reviews uploaded files and answers questions about them",
        "tools": [
          {
            "type": "action",
            "target": "summarize_doc",
            "boundInputs": {
              "doc_id": "system.uploaded_files[0].id"
            },
            "llmInputs": [],
            "stateUpdates": [],
            "name": "summarize_doc"
          }
        ],
        "developerName": "intake",
        "label": "Intake",
        "actionDefinitions": [
          {
            "developerName": "summarize_doc",
            "label": "Summarize Doc",
            "description": "Summarize an uploaded document",
            "includeInProgressIndicator": false,
            "invocationTargetType": "flow",
            "invocationTargetName": "summarize_doc",
            "inputType": [
              {
                "developerName": "doc_id",
                "label": "Doc Id",
                "description": "Doc Id",
                "dataType": "String",
                "isList": false,
                "required": false,
                "isUserInput": false
              }
            ],
            "outputType": [
              {
                "developerName": "summary",
                "label": "Summary",
                "description": "Summary",
                "dataType": "String",
                "isList": false,
                "isUsedByPlanner": true,
                "isDisplayable": false
              }
            ]
          }
        ],
        "instructions": "You are a document-processing assistant.",
        "focusPrompt": "{{state.AgentScriptInternal_agent_instructions}}",
        "beforeReasoningIteration": [
          {
            "type": "action",
            "target": "__state_update_action__",
            "enabled": "True",
            "stateUpdates": [
              {
                "AgentScriptInternal_agent_instructions": "template::\nYou have {{len(system.uploaded_files)}} file(s) uploaded.\nThe most recent upload is {{system.uploaded_files[-1].name}}."
              }
            ]
          },
          {
            "type": "action",
            "target": "__state_update_action__",
            "enabled": "True",
            "stateUpdates": [
              {
                "AgentScriptInternal_condition_1": "state.needs_summary"
              }
            ]
          },
          {
            "type": "action",
            "target": "__state_update_action__",
            "enabled": "state.AgentScriptInternal_condition_1",
            "stateUpdates": [
              {
                "AgentScriptInternal_agent_instructions": "template::{{state.AgentScriptInternal_agent_instructions}}\nFocus on the first three documents: {{system.uploaded_files[0:3]}}"
              }
            ]
          }
        ],
        "fileReferences": [
          {
            "all": true
          },
          {
            "index": -1
          },
          {
            "slice": {
              "start": 0,
              "stop": 3,
              "step": null
            },
            "enabled": "state.AgentScriptInternal_condition_1"
          }
        ]
      }
    ],
    "surfaces": [],
    "modalityParameters": {},
    "additionalParameters": {
      "reset_to_initial_node": true
    },
    "fileUpload": {
      "mode": "managed"
    }
  }
}

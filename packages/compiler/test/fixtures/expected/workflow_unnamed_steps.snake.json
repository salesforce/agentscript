{
  "schema_version": "2.0",
  "global_configuration": {
    "developer_name": "OrderStatusAgent",
    "label": "Order Status Agent",
    "description": "Checks order status through a workflow",
    "enable_enhanced_event_logs": false,
    "agent_type": "EinsteinServiceAgent",
    "context_variables": [],
    "default_agent_user": "test_user"
  },
  "agent_version": {
    "planner_type": "Atlas__ConcurrentMultiAgentOrchestration",
    "system_messages": [
      {
        "message": "Hello! How can I help?",
        "message_type": "Welcome"
      },
      {
        "message": "Sorry, something went wrong.",
        "message_type": "Error"
      }
    ],
    "state_variables": [
      {
        "developer_name": "AgentScriptInternal_next_topic",
        "label": "Next Topic",
        "description": "The next topic to be visited",
        "data_type": "string",
        "is_list": false,
        "default": "\"__EMPTY__\"",
        "visibility": "Internal"
      },
      {
        "developer_name": "AgentScriptInternal_agent_instructions",
        "label": "Agent Instructions",
        "description": "The agent instructions",
        "data_type": "string",
        "is_list": false,
        "default": "''",
        "visibility": "Internal"
      },
      {
        "developer_name": "order_id",
        "label": "Order Id",
        "description": "The order to look up",
        "data_type": "string",
        "is_list": false,
        "visibility": "Internal",
        "default": "''"
      },
      {
        "developer_name": "order_status",
        "label": "Order Status",
        "description": "The current order status",
        "data_type": "string",
        "is_list": false,
        "visibility": "Internal",
        "default": "''"
      },
      {
        "developer_name": "is_vip",
        "label": "Is Vip",
        "description": "Whether the customer is a VIP",
        "data_type": "boolean",
        "is_list": false,
        "visibility": "Internal",
        "default": false
      }
    ],
    "initial_node": "main",
    "nodes": [
      {
        "type": "subagent",
        "reasoning_type": "salesforce.default",
        "description": "Entry point",
        "tools": [
          {
            "type": "action",
            "target": "__state_update_action__",
            "state_updates": [
              {
                "AgentScriptInternal_next_topic": "\"order_status\""
              }
            ],
            "name": "check_status",
            "description": "Look up and report order status"
          }
        ],
        "developer_name": "main",
        "label": "Main",
        "action_definitions": [],
        "instructions": "You help customers check order status.",
        "focus_prompt": "{{state.AgentScriptInternal_agent_instructions}}",
        "before_reasoning_iteration": [
          {
            "type": "action",
            "target": "__state_update_action__",
            "enabled": "True",
            "state_updates": [
              {
                "AgentScriptInternal_agent_instructions": "template::\nRoute order status requests to the workflow."
              }
            ]
          }
        ],
        "after_all_tool_calls": [
          {
            "type": "handoff",
            "target": "order_status",
            "enabled": "state.AgentScriptInternal_next_topic==\"order_status\"",
            "state_updates": [
              {
                "AgentScriptInternal_next_topic": "\"__EMPTY__\""
              }
            ]
          }
        ]
      },
      {
        "type": "subagent",
        "reasoning_type": "salesforce.default",
        "description": "General support",
        "tools": [],
        "developer_name": "support",
        "label": "Support",
        "action_definitions": [],
        "instructions": "You help customers check order status.",
        "focus_prompt": "{{state.AgentScriptInternal_agent_instructions}}",
        "before_reasoning_iteration": [
          {
            "type": "action",
            "target": "__state_update_action__",
            "enabled": "True",
            "state_updates": [
              {
                "AgentScriptInternal_agent_instructions": "template::\nHelp the customer with anything else."
              }
            ]
          }
        ]
      },
      {
        "type": "workflow",
        "developer_name": "order_status",
        "label": "Order Status",
        "steps": [
          {
            "name": "main",
            "directives": [
              {
                "type": "ask_for",
                "llm_inputs": [
                  "order_id"
                ],
                "instructions": "Ask for the order number.",
                "developer_name": "order_status_main_ask_for_01"
              },
              {
                "type": "action",
                "target": "lookup_order",
                "bound_inputs": {
                  "orderId": "state.order_id"
                },
                "state_updates": [
                  {
                    "order_status": "result.status"
                  }
                ],
                "developer_name": "order_status_main_action_02"
              },
              {
                "type": "say",
                "text": "Your order {{state.order_id}} has shipped.",
                "enabled": "state.order_status == \"shipped\"",
                "developer_name": "order_status_main_say_03"
              },
              {
                "type": "say",
                "text": "As a VIP, we are prioritizing your order.",
                "enabled": "(not (state.order_status == \"shipped\")) and (state.is_vip)",
                "developer_name": "order_status_main_say_04"
              },
              {
                "type": "say",
                "text": "Your order is {{state.order_status}}.",
                "enabled": "(not (state.order_status == \"shipped\")) and (not (state.is_vip))",
                "developer_name": "order_status_main_say_05"
              },
              {
                "type": "handoff",
                "target": "support",
                "developer_name": "order_status_main_handoff_06"
              }
            ]
          }
        ],
        "description": "Look up and report order status",
        "action_definitions": [
          {
            "developer_name": "lookup_order",
            "label": "Lookup Order",
            "description": "Look up an order by id",
            "include_in_progress_indicator": false,
            "invocation_target_type": "flow",
            "invocation_target_name": "LookupOrder",
            "input_type": [
              {
                "developer_name": "orderId",
                "label": "Order Id",
                "description": "Order Id",
                "data_type": "String",
                "is_list": false,
                "required": false,
                "is_user_input": false
              }
            ],
            "output_type": [
              {
                "developer_name": "status",
                "label": "Status",
                "description": "Status",
                "data_type": "String",
                "is_list": false,
                "is_used_by_planner": true,
                "is_displayable": false
              }
            ]
          }
        ]
      }
    ],
    "surfaces": [],
    "modality_parameters": {},
    "additional_parameters": {
      "reset_to_initial_node": true,
      "system_messages": "[{\"message\": \"Hello! How can I help?\", \"messageType\": \"Welcome\"}, {\"message\": \"Sorry, something went wrong.\", \"messageType\": \"Error\"}]"
    }
  }
}

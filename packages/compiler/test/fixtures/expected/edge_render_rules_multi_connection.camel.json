{
  "schemaVersion": "2.0",
  "globalConfiguration": {
    "developerName": "EdgeRenderRulesMultiConnection",
    "label": "Multi-Channel Support Agent",
    "description": "Reasoning action with render_rules across messaging and voice",
    "enableEnhancedEventLogs": false,
    "agentType": "EinsteinServiceAgent",
    "contextVariables": [],
    "defaultAgentUser": "support_bot@example.com"
  },
  "agentVersion": {
    "plannerType": "Atlas__ConcurrentMultiAgentOrchestration",
    "systemMessages": [
      {
        "message": "Hi! How can I help you today?",
        "messageType": "Welcome"
      },
      {
        "message": "Sorry, something went wrong.",
        "messageType": "Error"
      }
    ],
    "stateVariables": [
      {
        "developerName": "AgentScriptInternal_next_topic",
        "label": "Next Topic",
        "description": "The next topic to be visited",
        "dataType": "string",
        "isList": false,
        "default": "\"__EMPTY__\"",
        "visibility": "Internal"
      },
      {
        "developerName": "AgentScriptInternal_agent_instructions",
        "label": "Agent Instructions",
        "description": "The agent instructions",
        "dataType": "string",
        "isList": false,
        "default": "''",
        "visibility": "Internal"
      }
    ],
    "initialNode": "main",
    "nodes": [
      {
        "type": "subagent",
        "reasoningType": "salesforce.default",
        "description": "Handle support requests across channels",
        "tools": [],
        "developerName": "main",
        "label": "Main",
        "actionDefinitions": [],
        "instructions": "You are a support agent available across messaging and voice channels."
      },
      {
        "type": "subagent",
        "reasoningType": "salesforce.default",
        "description": "Find restaurants for the user",
        "tools": [
          {
            "type": "action",
            "target": "Get_List_of_Restaurants",
            "boundInputs": {
              "location": "\"seattle\""
            },
            "llmInputs": [],
            "stateUpdates": [],
            "name": "Get_List_of_Restaurants",
            "renderRules": [
              {
                "surfaceType": "messaging",
                "responseFormatName": "choices",
                "endTurn": true
              },
              {
                "surfaceType": "voice",
                "responseFormatName": "spoken",
                "endTurn": false
              }
            ]
          }
        ],
        "developerName": "find_restaurants",
        "label": "Find Restaurants",
        "actionDefinitions": [
          {
            "developerName": "Get_List_of_Restaurants",
            "label": "Get List Of Restaurants",
            "description": "Fetch restaurants",
            "requireUserConfirmation": false,
            "includeInProgressIndicator": false,
            "invocationTargetType": "flow",
            "invocationTargetName": "GetList",
            "inputType": [
              {
                "developerName": "location",
                "label": "Location",
                "description": "Location",
                "dataType": "String",
                "isList": false,
                "required": false,
                "isUserInput": false
              }
            ],
            "outputType": []
          }
        ],
        "instructions": "You are a support agent available across messaging and voice channels.",
        "focusPrompt": "{{state.AgentScriptInternal_agent_instructions}}",
        "beforeReasoningIteration": [
          {
            "type": "action",
            "target": "__state_update_action__",
            "enabled": "True",
            "stateUpdates": [
              {
                "AgentScriptInternal_agent_instructions": "''"
              }
            ]
          },
          {
            "type": "action",
            "target": "__state_update_action__",
            "stateUpdates": [
              {
                "AgentScriptInternal_agent_instructions": "template::{{state.AgentScriptInternal_agent_instructions}}\nHelp the user find restaurants.\nAdapt the response to the channel."
              }
            ]
          }
        ]
      }
    ],
    "surfaces": [
      {
        "surfaceType": "messaging",
        "outboundRouteConfigs": [],
        "responseFormats": [
          {
            "developerName": "choices",
            "label": "Choices",
            "description": "Choice format for messaging channel",
            "inputSchema": "{\"type\":\"object\",\"properties\":{\"items\":{\"type\":\"string\"}},\"required\":[\"items\"]}"
          },
          {
            "developerName": "rich_card",
            "label": "Rich Card",
            "description": "Rich card format for messaging channel",
            "inputSchema": "{\"type\":\"object\",\"properties\":{\"title\":{\"type\":\"string\"}},\"required\":[\"title\"]}"
          }
        ]
      },
      {
        "surfaceType": "voice",
        "outboundRouteConfigs": [],
        "responseFormats": [
          {
            "developerName": "spoken",
            "label": "Spoken",
            "description": "Spoken response for voice channel",
            "inputSchema": "{\"type\":\"object\",\"properties\":{\"utterance\":{\"type\":\"string\"}},\"required\":[\"utterance\"]}"
          }
        ]
      }
    ],
    "modalityParameters": {},
    "additionalParameters": {
      "reset_to_initial_node": true,
      "system_messages": "[{\"message\": \"Hi! How can I help you today?\", \"messageType\": \"Welcome\"}, {\"message\": \"Sorry, something went wrong.\", \"messageType\": \"Error\"}]"
    }
  }
}

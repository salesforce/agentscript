{
  "schema_version": "2.0",
  "global_configuration": {
    "developer_name": "EdgeRenderRulesMultiConnection",
    "label": "Multi-Channel Support Agent",
    "description": "Reasoning action with render_rules across messaging and voice",
    "enable_enhanced_event_logs": false,
    "agent_type": "EinsteinServiceAgent",
    "context_variables": [],
    "default_agent_user": "support_bot@example.com"
  },
  "agent_version": {
    "planner_type": "Atlas__ConcurrentMultiAgentOrchestration",
    "system_messages": [
      {
        "message": "Hi! How can I help you today?",
        "message_type": "Welcome"
      },
      {
        "message": "Sorry, something went wrong.",
        "message_type": "Error"
      }
    ],
    "state_variables": [
      {
        "developer_name": "AgentScriptInternal_next_topic",
        "label": "Next Topic",
        "description": "The next topic to be visited",
        "data_type": "string",
        "is_list": false,
        "default": "\"__EMPTY__\"",
        "visibility": "Internal"
      },
      {
        "developer_name": "AgentScriptInternal_agent_instructions",
        "label": "Agent Instructions",
        "description": "The agent instructions",
        "data_type": "string",
        "is_list": false,
        "default": "''",
        "visibility": "Internal"
      }
    ],
    "initial_node": "main",
    "nodes": [
      {
        "type": "subagent",
        "reasoning_type": "salesforce.default",
        "description": "Handle support requests across channels",
        "tools": [],
        "developer_name": "main",
        "label": "Main",
        "action_definitions": [],
        "instructions": "You are a support agent available across messaging and voice channels."
      },
      {
        "type": "subagent",
        "reasoning_type": "salesforce.default",
        "description": "Find restaurants for the user",
        "tools": [
          {
            "type": "action",
            "target": "Get_List_of_Restaurants",
            "bound_inputs": {
              "location": "\"seattle\""
            },
            "llm_inputs": [],
            "state_updates": [],
            "name": "Get_List_of_Restaurants",
            "render_rules": [
              {
                "surface_type": "messaging",
                "response_format_name": "choices",
                "end_turn": true
              },
              {
                "surface_type": "voice",
                "response_format_name": "spoken",
                "end_turn": false
              }
            ]
          }
        ],
        "developer_name": "find_restaurants",
        "label": "Find Restaurants",
        "action_definitions": [
          {
            "developer_name": "Get_List_of_Restaurants",
            "label": "Get List Of Restaurants",
            "description": "Fetch restaurants",
            "require_user_confirmation": false,
            "include_in_progress_indicator": false,
            "invocation_target_type": "flow",
            "invocation_target_name": "GetList",
            "input_type": [
              {
                "developer_name": "location",
                "label": "Location",
                "description": "Location",
                "data_type": "String",
                "is_list": false,
                "required": false,
                "is_user_input": false
              }
            ],
            "output_type": []
          }
        ],
        "instructions": "You are a support agent available across messaging and voice channels.",
        "focus_prompt": "{{state.AgentScriptInternal_agent_instructions}}",
        "before_reasoning_iteration": [
          {
            "type": "action",
            "target": "__state_update_action__",
            "enabled": "True",
            "state_updates": [
              {
                "AgentScriptInternal_agent_instructions": "''"
              }
            ]
          },
          {
            "type": "action",
            "target": "__state_update_action__",
            "state_updates": [
              {
                "AgentScriptInternal_agent_instructions": "template::{{state.AgentScriptInternal_agent_instructions}}\nHelp the user find restaurants.\nAdapt the response to the channel."
              }
            ]
          }
        ]
      }
    ],
    "surfaces": [
      {
        "surface_type": "messaging",
        "outbound_route_configs": [],
        "response_formats": [
          {
            "developer_name": "choices",
            "label": "Choices",
            "description": "Choice format for messaging channel",
            "input_schema": "{\"type\":\"object\",\"properties\":{\"items\":{\"type\":\"string\"}},\"required\":[\"items\"]}"
          },
          {
            "developer_name": "rich_card",
            "label": "Rich Card",
            "description": "Rich card format for messaging channel",
            "input_schema": "{\"type\":\"object\",\"properties\":{\"title\":{\"type\":\"string\"}},\"required\":[\"title\"]}"
          }
        ]
      },
      {
        "surface_type": "voice",
        "outbound_route_configs": [],
        "response_formats": [
          {
            "developer_name": "spoken",
            "label": "Spoken",
            "description": "Spoken response for voice channel",
            "input_schema": "{\"type\":\"object\",\"properties\":{\"utterance\":{\"type\":\"string\"}},\"required\":[\"utterance\"]}"
          }
        ]
      }
    ],
    "modality_parameters": {},
    "additional_parameters": {
      "reset_to_initial_node": true,
      "system_messages": "[{\"message\": \"Hi! How can I help you today?\", \"messageType\": \"Welcome\"}, {\"message\": \"Sorry, something went wrong.\", \"messageType\": \"Error\"}]"
    }
  }
}

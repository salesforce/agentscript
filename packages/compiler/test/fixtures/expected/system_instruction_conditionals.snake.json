{
  "schema_version": "2.0",
  "global_configuration": {
    "developer_name": "AdaptiveSupport",
    "label": "Adaptive Support",
    "description": "Adaptive Support",
    "enable_enhanced_event_logs": false,
    "agent_type": "EinsteinServiceAgent",
    "context_variables": [],
    "default_agent_user": "test@example.com"
  },
  "agent_version": {
    "planner_type": "Atlas__ConcurrentMultiAgentOrchestration",
    "system_messages": [],
    "state_variables": [
      {
        "developer_name": "AgentScriptInternal_next_topic",
        "label": "Next Topic",
        "description": "The next topic to be visited",
        "data_type": "string",
        "is_list": false,
        "default": "\"__EMPTY__\"",
        "visibility": "Internal"
      },
      {
        "developer_name": "AgentScriptInternal_agent_instructions",
        "label": "Agent Instructions",
        "description": "The agent instructions",
        "data_type": "string",
        "is_list": false,
        "default": "''",
        "visibility": "Internal"
      },
      {
        "developer_name": "AgentScriptInternal_condition_1",
        "label": "Runtime Condition 1",
        "description": "Runtime condition evaluation for if statements",
        "data_type": "boolean",
        "is_list": false,
        "visibility": "Internal"
      },
      {
        "developer_name": "AgentScriptInternal_condition_2",
        "label": "Runtime Condition 2",
        "description": "Runtime condition evaluation for else-if chain link 2",
        "data_type": "boolean",
        "is_list": false,
        "visibility": "Internal"
      },
      {
        "developer_name": "AgentScriptInternal_system_instructions",
        "label": "System Instructions",
        "description": "Dynamic system instructions for the current turn",
        "data_type": "string",
        "is_list": false,
        "default": "''",
        "visibility": "Internal"
      }
    ],
    "initial_node": "main",
    "nodes": [
      {
        "type": "subagent",
        "reasoning_type": "salesforce.default",
        "description": "Adapts instructions to the current interaction.",
        "tools": [],
        "developer_name": "main",
        "label": "Adaptive Support",
        "action_definitions": [],
        "instructions": "{{state.AgentScriptInternal_system_instructions}}",
        "focus_prompt": "{{state.AgentScriptInternal_agent_instructions}}",
        "before_reasoning_iteration": [
          {
            "type": "action",
            "target": "__state_update_action__",
            "enabled": "True",
            "state_updates": [
              {
                "AgentScriptInternal_system_instructions": "template::\nYou are a customer support assistant."
              }
            ]
          },
          {
            "type": "action",
            "target": "__state_update_action__",
            "enabled": "True",
            "state_updates": [
              {
                "AgentScriptInternal_condition_1": "system.current_modality == \"voice\""
              }
            ]
          },
          {
            "type": "action",
            "target": "__state_update_action__",
            "enabled": "state.AgentScriptInternal_condition_1",
            "state_updates": [
              {
                "AgentScriptInternal_system_instructions": "template::{{state.AgentScriptInternal_system_instructions}}\nKeep responses concise, conversational, and free of formatting."
              }
            ]
          },
          {
            "type": "action",
            "target": "__state_update_action__",
            "enabled": "True",
            "state_updates": [
              {
                "AgentScriptInternal_condition_2": "system.current_connection == \"slack\""
              }
            ]
          },
          {
            "type": "action",
            "target": "__state_update_action__",
            "enabled": "(not (state.AgentScriptInternal_condition_1)) and (state.AgentScriptInternal_condition_2)",
            "state_updates": [
              {
                "AgentScriptInternal_system_instructions": "template::{{state.AgentScriptInternal_system_instructions}}\nUse short paragraphs and Slack-compatible formatting."
              }
            ]
          },
          {
            "type": "action",
            "target": "__state_update_action__",
            "enabled": "(not (state.AgentScriptInternal_condition_1)) and (not (state.AgentScriptInternal_condition_2))",
            "state_updates": [
              {
                "AgentScriptInternal_system_instructions": "template::{{state.AgentScriptInternal_system_instructions}}\nUse the standard text response style."
              }
            ]
          },
          {
            "type": "action",
            "target": "__state_update_action__",
            "enabled": "True",
            "state_updates": [
              {
                "AgentScriptInternal_agent_instructions": "template::\nResolve the customer's request."
              }
            ]
          }
        ]
      }
    ],
    "surfaces": [],
    "modality_parameters": {},
    "additional_parameters": {
      "reset_to_initial_node": true
    }
  }
}

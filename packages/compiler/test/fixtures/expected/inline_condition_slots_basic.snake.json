{
  "schema_version": "2.0",
  "global_configuration": {
    "developer_name": "InlineConditionSlotsBasic",
    "label": "Inline Condition Slots Basic",
    "description": "Inline Condition Slots Basic",
    "enable_enhanced_event_logs": false,
    "agent_type": "EinsteinServiceAgent",
    "context_variables": [],
    "default_agent_user": "service_user"
  },
  "agent_version": {
    "planner_type": "Atlas__ConcurrentMultiAgentOrchestration",
    "system_messages": [],
    "state_variables": [
      {
        "developer_name": "AgentScriptInternal_next_topic",
        "label": "Next Topic",
        "description": "The next topic to be visited",
        "data_type": "string",
        "is_list": false,
        "default": "\"__EMPTY__\"",
        "visibility": "Internal"
      },
      {
        "developer_name": "AgentScriptInternal_agent_instructions",
        "label": "Agent Instructions",
        "description": "The agent instructions",
        "data_type": "string",
        "is_list": false,
        "default": "''",
        "visibility": "Internal"
      },
      {
        "developer_name": "is_vip",
        "label": "Is Vip",
        "description": "Is Vip",
        "data_type": "boolean",
        "is_list": false,
        "visibility": "Internal",
        "default": false
      },
      {
        "developer_name": "needs_review",
        "label": "Needs Review",
        "description": "Needs Review",
        "data_type": "boolean",
        "is_list": false,
        "visibility": "Internal",
        "default": false
      },
      {
        "developer_name": "priority",
        "label": "Priority",
        "description": "Priority",
        "data_type": "string",
        "is_list": false,
        "visibility": "Internal",
        "default": "'normal'"
      }
    ],
    "initial_node": "main",
    "nodes": [
      {
        "type": "subagent",
        "reasoning_type": "salesforce.default",
        "description": "Single-read conditions are inlined into the gate",
        "tools": [],
        "developer_name": "main",
        "label": "Main",
        "action_definitions": [],
        "instructions": "You are a helpful AI assistant.",
        "focus_prompt": "{{state.AgentScriptInternal_agent_instructions}}",
        "before_reasoning_iteration": [
          {
            "type": "action",
            "target": "__state_update_action__",
            "enabled": "True",
            "state_updates": [
              {
                "AgentScriptInternal_agent_instructions": "''"
              }
            ]
          },
          {
            "type": "action",
            "target": "__state_update_action__",
            "enabled": "state.is_vip",
            "state_updates": [
              {
                "AgentScriptInternal_agent_instructions": "template::{{state.AgentScriptInternal_agent_instructions}}\nGreet the customer as a VIP.\nOffer priority support."
              }
            ]
          },
          {
            "type": "action",
            "target": "__state_update_action__",
            "state_updates": [
              {
                "AgentScriptInternal_agent_instructions": "template::{{state.AgentScriptInternal_agent_instructions}}\nHow can I help?"
              }
            ]
          }
        ],
        "before_reasoning": [
          {
            "type": "action",
            "target": "__state_update_action__",
            "enabled": "True",
            "state_updates": [
              {
                "AgentScriptInternal_next_topic": "\"__EMPTY__\""
              }
            ]
          },
          {
            "type": "action",
            "target": "__state_update_action__",
            "enabled": "(state.AgentScriptInternal_next_topic==\"__EMPTY__\") and (state.is_vip)",
            "state_updates": [
              {
                "priority": "\"high\""
              }
            ]
          },
          {
            "type": "action",
            "target": "__state_update_action__",
            "enabled": "(state.AgentScriptInternal_next_topic==\"__EMPTY__\") and (state.needs_review)",
            "state_updates": [
              {
                "AgentScriptInternal_next_topic": "\"escalations\""
              }
            ]
          },
          {
            "type": "handoff",
            "target": "escalations",
            "enabled": "state.AgentScriptInternal_next_topic==\"escalations\"",
            "state_updates": [
              {
                "AgentScriptInternal_next_topic": "\"__EMPTY__\""
              }
            ]
          }
        ]
      },
      {
        "type": "subagent",
        "reasoning_type": "salesforce.default",
        "description": "Handles escalated requests",
        "tools": [],
        "developer_name": "escalations",
        "label": "Escalations",
        "action_definitions": [],
        "instructions": "You are a helpful AI assistant.",
        "focus_prompt": "{{state.AgentScriptInternal_agent_instructions}}",
        "before_reasoning_iteration": [
          {
            "type": "action",
            "target": "__state_update_action__",
            "enabled": "True",
            "state_updates": [
              {
                "AgentScriptInternal_agent_instructions": "template::\nHandle the escalated request"
              }
            ]
          }
        ]
      }
    ],
    "surfaces": [],
    "modality_parameters": {},
    "additional_parameters": {
      "reset_to_initial_node": true
    }
  }
}

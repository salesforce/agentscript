{
  "schemaVersion": "2.0",
  "globalConfiguration": {
    "developerName": "InlineConditionSlotsBasic",
    "label": "Inline Condition Slots Basic",
    "description": "Inline Condition Slots Basic",
    "enableEnhancedEventLogs": false,
    "agentType": "EinsteinServiceAgent",
    "contextVariables": [],
    "defaultAgentUser": "service_user"
  },
  "agentVersion": {
    "plannerType": "Atlas__ConcurrentMultiAgentOrchestration",
    "systemMessages": [],
    "stateVariables": [
      {
        "developerName": "AgentScriptInternal_next_topic",
        "label": "Next Topic",
        "description": "The next topic to be visited",
        "dataType": "string",
        "isList": false,
        "default": "\"__EMPTY__\"",
        "visibility": "Internal"
      },
      {
        "developerName": "AgentScriptInternal_agent_instructions",
        "label": "Agent Instructions",
        "description": "The agent instructions",
        "dataType": "string",
        "isList": false,
        "default": "''",
        "visibility": "Internal"
      },
      {
        "developerName": "is_vip",
        "label": "Is Vip",
        "description": "Is Vip",
        "dataType": "boolean",
        "isList": false,
        "visibility": "Internal",
        "default": false
      },
      {
        "developerName": "needs_review",
        "label": "Needs Review",
        "description": "Needs Review",
        "dataType": "boolean",
        "isList": false,
        "visibility": "Internal",
        "default": false
      },
      {
        "developerName": "priority",
        "label": "Priority",
        "description": "Priority",
        "dataType": "string",
        "isList": false,
        "visibility": "Internal",
        "default": "'normal'"
      }
    ],
    "initialNode": "main",
    "nodes": [
      {
        "type": "subagent",
        "reasoningType": "salesforce.default",
        "description": "Single-read conditions are inlined into the gate",
        "tools": [],
        "developerName": "main",
        "label": "Main",
        "actionDefinitions": [],
        "instructions": "You are a helpful AI assistant.",
        "focusPrompt": "{{state.AgentScriptInternal_agent_instructions}}",
        "beforeReasoningIteration": [
          {
            "type": "action",
            "target": "__state_update_action__",
            "enabled": "True",
            "stateUpdates": [
              {
                "AgentScriptInternal_agent_instructions": "''"
              }
            ]
          },
          {
            "type": "action",
            "target": "__state_update_action__",
            "enabled": "state.is_vip",
            "stateUpdates": [
              {
                "AgentScriptInternal_agent_instructions": "template::{{state.AgentScriptInternal_agent_instructions}}\nGreet the customer as a VIP.\nOffer priority support."
              }
            ]
          },
          {
            "type": "action",
            "target": "__state_update_action__",
            "stateUpdates": [
              {
                "AgentScriptInternal_agent_instructions": "template::{{state.AgentScriptInternal_agent_instructions}}\nHow can I help?"
              }
            ]
          }
        ],
        "beforeReasoning": [
          {
            "type": "action",
            "target": "__state_update_action__",
            "enabled": "True",
            "stateUpdates": [
              {
                "AgentScriptInternal_next_topic": "\"__EMPTY__\""
              }
            ]
          },
          {
            "type": "action",
            "target": "__state_update_action__",
            "enabled": "(state.AgentScriptInternal_next_topic==\"__EMPTY__\") and (state.is_vip)",
            "stateUpdates": [
              {
                "priority": "\"high\""
              }
            ]
          },
          {
            "type": "action",
            "target": "__state_update_action__",
            "enabled": "(state.AgentScriptInternal_next_topic==\"__EMPTY__\") and (state.needs_review)",
            "stateUpdates": [
              {
                "AgentScriptInternal_next_topic": "\"escalations\""
              }
            ]
          },
          {
            "type": "handoff",
            "target": "escalations",
            "enabled": "state.AgentScriptInternal_next_topic==\"escalations\"",
            "stateUpdates": [
              {
                "AgentScriptInternal_next_topic": "\"__EMPTY__\""
              }
            ]
          }
        ]
      },
      {
        "type": "subagent",
        "reasoningType": "salesforce.default",
        "description": "Handles escalated requests",
        "tools": [],
        "developerName": "escalations",
        "label": "Escalations",
        "actionDefinitions": [],
        "instructions": "You are a helpful AI assistant.",
        "focusPrompt": "{{state.AgentScriptInternal_agent_instructions}}",
        "beforeReasoningIteration": [
          {
            "type": "action",
            "target": "__state_update_action__",
            "enabled": "True",
            "stateUpdates": [
              {
                "AgentScriptInternal_agent_instructions": "template::\nHandle the escalated request"
              }
            ]
          }
        ]
      }
    ],
    "surfaces": [],
    "modalityParameters": {},
    "additionalParameters": {
      "reset_to_initial_node": true
    }
  }
}

{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // test/perf imports fixtures from ../compiler/test
    "rootDir": "..",
    "noEmit": true,
    // Tests import the package by name; check them against src, not a
    // possibly stale (or not yet built) dist.
    "paths": {
      "@agentscript/agentforce": ["./src/index.ts"]
    }
  },
  "include": ["src/**/*", "test/**/*", "tests/**/*", "vitest.config.ts"],
  "exclude": ["node_modules", "dist"]
}
